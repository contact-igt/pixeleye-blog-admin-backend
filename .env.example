# ===========================
# Application Configuration
# ===========================
APP_STAGE=local
PORT=5000
API_PREFIX=/api/v1
APP_VERSION=0.1.0

# ===========================
# Database Configuration
# ===========================
# For local development:
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=pixel_eye_blog_db
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=

# For staging/development:
DEVELOPMENT_DB_HOST=localhost
DEVELOPMENT_DB_PORT=3306
DEVELOPMENT_DB_NAME=pixel_eye_blog_db
DEVELOPMENT_DB_USER=root
DEVELOPMENT_DB_PASSWORD=

# For production (supply via deployment secrets):
PRODUCTION_DB_HOST=
PRODUCTION_DB_PORT=3306
PRODUCTION_DB_NAME=
PRODUCTION_DB_USER=
PRODUCTION_DB_PASSWORD=

# Test database
DB_TEST_NAME=pixel_eye_blog_test
DB_LOGGING=false

# ===========================
# Frontend URLs
# ===========================
ADMIN_FRONTEND_URL=http://localhost:3000
PUBLIC_WEBSITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ===========================
# JWT Configuration
# ===========================
JWT_ACCESS_SECRET=change-me-to-secure-random-value-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=pixel-eye-blog-backend
JWT_AUDIENCE=pixel-eye-blog-admin

# ===========================
# Authentication Settings
# ===========================
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_SESSION_HISTORY_RETENTION_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=5

# ===========================
# Initial Super Admin
# ===========================
INITIAL_SUPER_ADMIN_NAME=Admin Name
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=securepassword

# ===========================
# Cloudflare R2 Storage
# ===========================
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pixel-eye-blog-media
R2_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_OBJECT_PREFIX=pixel-eye-blog
R2_MAX_FILE_SIZE_MB=5
R2_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/avif

# ===========================
# SMTP Configuration
# ===========================
# Gmail SMTP (recommended for local/test):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-app-specific-password
#
# Gmail with SSL (alternative):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-app-specific-password
#
# Important Notes:
# - Port 587 uses STARTTLS (SMTP_SECURE=false)
# - Port 465 uses implicit TLS (SMTP_SECURE=true)
# - Gmail requires an application-specific password, not your account password
# - Never commit real credentials to version control
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
MAIL_FROM_NAME=Pixel Eye Blog
MAIL_FROM_EMAIL=your-email@gmail.com

# ===========================
# Newsletter Configuration
# ===========================
# Token TTL for email verification (hours)
NEWSLETTER_VERIFICATION_TOKEN_TTL_HOURS=24

# Cooldown between resend attempts (minutes)
NEWSLETTER_VERIFICATION_RESEND_COOLDOWN_MINUTES=5

# Newsletter worker settings
NEWSLETTER_WORKER_BATCH_SIZE=50
NEWSLETTER_WORKER_CONCURRENCY=5
NEWSLETTER_WORKER_INTERVAL_SECONDS=10
NEWSLETTER_MAX_ATTEMPTS=3
NEWSLETTER_RETRY_BASE_DELAY_SECONDS=300
NEWSLETTER_STALE_DELIVERY_MINUTES=30
NEWSLETTER_SHUTDOWN_TIMEOUT_SECONDS=30

# Hashing secrets for tokens
NEWSLETTER_HASH_SECRET=change-me-to-secure-random-value-in-production

# ===========================
# Feedback Configuration
# ===========================
FEEDBACK_VISITOR_HASH_SECRET=change-me-to-secure-random-value-in-production

# ===========================
# Logging
# ===========================
# Options: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
