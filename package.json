{
  "name": "pixel-eye-blog-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/index-newsletter-worker.ts",
    "start": "node dist/server.js",
    "newsletter:worker": "node dist/index-newsletter-worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:drop": "sequelize-cli db:drop",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "tsx src/scripts/reset-database.ts",
    "verify:integrations": "tsx src/scripts/verify-integrations.ts",
    "auth:sessions:cleanup": "tsx src/scripts/cleanup-auth-sessions.ts",
    "media:trash:purge": "tsx src/scripts/purge-media-trash.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/html": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/multer": "^2.2.0",
    "@types/sanitize-html": "^2.16.1",
    "compression": "latest",
    "cors": "latest",
    "cron": "^4.4.0",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "multer": "^2.2.0",
    "mysql2": "latest",
    "nodemailer": "latest",
    "pino": "latest",
    "sanitize-html": "^2.17.6",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/compression": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/supertest": "latest",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "pino-pretty": "^13.1.3",
    "sequelize-cli": "latest",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
